# =============================================================================
# Smart RT Environment Configuration Example
# =============================================================================
# Salin file ini ke `.env.local` untuk Next.js development/production.
# JANGAN PERNAH mengunggah `.env.local` atau mengisi nilai rahasia asli ke file ini.

# -----------------------------------------------------------------------------
# 1. Next.js Application Variables (PUBLIC — Di-bundle ke Browser & Server)
# -----------------------------------------------------------------------------
# Base URL project Supabase (TANPA suffix /rest/v1/).
# Dapatkan dari Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Kunci publik Supabase (anon atau publishable key yang tunduk pada RLS).
# DILARANG keras menggunakan service_role key atau secret server-only dengan prefix NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# -----------------------------------------------------------------------------
# 2. Supabase Edge Functions & Background Worker (SERVER-ONLY)
# -----------------------------------------------------------------------------
# Simpan variabel berikut HANYA di environment Edge Functions (`supabase secrets set`)
# atau file `.env` lokal Edge Functions (`supabase/functions/.env`) yang di-ignore Git.
# JANGAN PERNAH menambahkan prefix NEXT_PUBLIC_ pada variabel di bawah ini.
#
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# STORAGE_DELETION_WORKER_SECRET=replace-with-random-secret-at-least-32-utf8-bytes
#
# Opsional (konfigurasi tuning worker / orphan scan):
# WORKER_BATCH_SIZE=10
# WORKER_LEASE_SECONDS=300
# WORKER_STORAGE_TIMEOUT_MS=60000
# WORKER_DB_TIMEOUT_MS=10000
# WORKER_RENEW_MARGIN_MS=120000
# WORKER_MAX_JOBS_PER_INVOCATION=50
# WORKER_INVOCATION_TIMEOUT_MS=110000
# WORKER_ORPHAN_RETENTION_HOURS=24
# WORKER_ORPHAN_SCAN_LIMIT=100
# ORPHAN_LEASE_RENEW_THRESHOLD_MS=120000
# ORPHAN_DOMAIN_RETENTION_DAYS=7
# ORPHAN_DOMAIN_RETENTION_LIMIT=100

# -----------------------------------------------------------------------------
# 3. Supabase PostgreSQL Vault Secrets (SERVER-ONLY via supabase/ops/storage-scheduler-setup.sql)
# -----------------------------------------------------------------------------
# Disimpan di vault.secrets (bukan .env Next.js):
# - STORAGE_ORPHAN_SCAN_URL=https://your-project-ref.supabase.co/functions/v1/storage-orphan-scan
# - STORAGE_DELETION_WORKER_SECRET=(harus identik dengan secret Edge Functions)
