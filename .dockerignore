# Environment & secret files — NEVER include in Docker build context
.env
.env.*
!.env.example
supabase/functions/.env*

# Version control & local IDE state
.git
.gitignore
.DS_Store
.vscode
.idea

# Build outputs & dependencies (rebuilt cleanly inside container)
node_modules
.next
out
build
coverage
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Non-runtime directories (migrations, edge functions, tests, docs, QA artifacts)
supabase
tests
docs
.playwright-mcp
playwright-report
test-results
*.md

