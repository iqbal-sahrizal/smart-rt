<resources>
    <!-- Dark mode application theme -->
    <style name="Theme.SmartRT" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_deep_navy</item>
        <item name="colorAccent">@color/brand_teal</item>
        <item name="android:windowBackground">@color/brand_background_dark</item>
        <item name="android:statusBarColor">@color/brand_surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/brand_surface_dark</item>
    </style>

    <style name="Theme.SmartRT.Splash" parent="Theme.SmartRT">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/brand_deep_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>

